      <aliases enabled='yes' />
      <column caption='AppointmentDay (v appointment risk.csv)' datatype='date' name='[AppointmentDay (v_appointment_risk.csv)]' role='dimension' type='ordinal' />
      <column caption='Appointment Day' datatype='datetime' name='[AppointmentDay]' role='dimension' type='ordinal' />
      <column caption='AppointmentID (v appointment risk.csv)' datatype='integer' name='[AppointmentID (v_appointment_risk.csv)]' role='measure' type='quantitative' />
      <column caption='Appointment ID' datatype='integer' name='[AppointmentID]' role='dimension' type='ordinal' />
      <column caption='No-Show Rate' datatype='real' name='[Calculation_1534982983974912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF[No-show]=&quot;Yes&quot; THEN 1 ELSE 0 END) /COUNT([No-show])' />
      </column>
      <column caption='Lead Time Bucket' datatype='string' name='[Calculation_1534983003758595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lead_time_days] = 0 THEN &quot;1.Same Day&quot;&#13;&#10;ELSEIF [lead_time_days] &gt;=1 AND [lead_time_days]&lt;=3 &#13;&#10;THEN &quot;2.Short(1-3 Days)&quot;&#13;&#10;ELSEIF [lead_time_days] &gt;=4 AND [lead_time_days]&lt;=7 &#13;&#10;THEN &quot;3.Within Week&quot;&#13;&#10;ELSE &quot;4.Long Lead(8+ Days)&quot;&#13;&#10;END' />
      </column>
      <column caption='Neighbourhood (v appointment risk.csv)' datatype='string' name='[Neighbourhood (v_appointment_risk.csv)]' role='dimension' type='nominal' />
